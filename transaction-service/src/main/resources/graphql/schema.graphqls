type Query {
    transactionsByAccount(accountId: ID!): [TransactionResponse]
    transactionById(id: ID!): TransactionResponse
    maxTransactionLimit: Float
}

type Mutation {
    createTransaction(input: TransactionInput!): TransactionResponse
    executeTransfer(input: TransferInput!): String
}

type TransactionResponse {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}

input TransferInput {
    sourceAccountId: ID!
    targetAccountId: ID!
    amount: Float!
    currency: String!
}

